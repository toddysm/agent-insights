{
  "name": "agent-insights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && esbuild src/web/app.tsx --bundle --minify --outfile=.build/public/app.js",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test .build/tests/*.test.js tests/startup.test.mjs",
    "test:startup": "node --test tests/startup.test.mjs",
    "test:browser": "npm run build && playwright test",
    "prestart": "npm run build",
    "start": "node .build/src/runtime/cli.js"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "@playwright/test": "1.64.1"
  }
}
